NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Market data (required for stock search and news)
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Database (required for accounts, sessions, and watchlists)
# Atlas connection string should select the abuk_invest database, e.g. end with /abuk_invest
# Keep the real URI in a local .env.local file or Codespaces secret; never commit it.
MONGODB_URI=

# Authentication (required for sign-up and sign-in)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI features
GEMINI_API_KEY=

# Email notifications
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
